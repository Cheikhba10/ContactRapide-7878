<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- EN-TÊTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="Logo ContactRapide"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ContactRapide"
                    android:textColor="#111827"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AGENCE DES PARCELLES ASSAINIES"
                    android:textColor="#16A34A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="22dp" />

        <!-- ACCUEIL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="#FFFFFF"
            android:elevation="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenue 👋"
                android:textColor="#111827"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Trouvez rapidement le personnel dont vous avez besoin."
                android:textColor="#6B7280"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnUrgence"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:text="📞  APPELER L'AGENCE"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#16A34A" />

            <Button
                android:id="@+id/navWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:text="💬  WHATSAPP"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#22C55E" />

        </LinearLayout>

        <!-- SERVICES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Nos services"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- NANNY -->
        <Button
            android:id="@+id/serviceNanny"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:text="👶  Nanny / Garde d'enfants"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="start|center_vertical"
            android:paddingStart="18dp"
            android:backgroundTint="#FFFFFF" />

        <!-- MENAGE -->
        <Button
            android:id="@+id/serviceMenage"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:text="🧹  Ménage &amp; Cuisine"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="start|center_vertical"
            android:paddingStart="18dp"
            android:backgroundTint="#FFFFFF" />

        <!-- CHAUFFEUR -->
        <Button
            android:id="@+id/serviceChauffeur"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:text="🚗  Chauffeur &amp; Sécurité"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="start|center_vertical"
            android:paddingStart="18dp"
            android:backgroundTint="#FFFFFF" />

        <!-- POLYVALENT -->
        <Button
            android:id="@+id/servicePolyvalent"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:text="🏠  Personnel Polyvalent"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="start|center_vertical"
            android:paddingStart="18dp"
            android:backgroundTint="#FFFFFF" />

        <!-- DEMANDE -->
        <Button
            android:id="@+id/navDemander"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="22dp"
            android:text="📝  FAIRE UNE DEMANDE"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#111827" />

        <Button
            android:id="@+id/navProfil"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="👤  MON PROFIL"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FFFFFF" />

        <!-- PIED DE PAGE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="📍 Parcelles Assainies • Dakar"
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="ContactRapide • Service professionnel"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
